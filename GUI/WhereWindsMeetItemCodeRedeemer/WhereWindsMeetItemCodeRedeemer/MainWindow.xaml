<Window x:Class="WhereWindsMeetItemCodeRedeemer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:WhereWindsMeetItemCodeRedeemer.Converters"
        xmlns:viewModels="clr-namespace:WhereWindsMeetItemCodeRedeemer.ViewModels"
        mc:Ignorable="d"
        Title="Where Winds Meet - Auto Item Code Redeemer"
        Height="780" Width="1050"
        MinHeight="650" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI, Segoe UI Variable, sans-serif">

    <Window.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
        <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
        <converters:EnumToBooleanConverter x:Key="EnumToBoolConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- General Button Style -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="Foreground" Value="#64748B"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RedeemButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="22,10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StopButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="22,10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="16" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3B82F6"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- Top Header & Game Status -->
            <RowDefinition Height="Auto"/>
            <!-- Action Bar & Controls -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area: Codes List & Activity Log -->
            <RowDefinition Height="*"/>
            <!-- Bottom Status & Progress Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER & GAME STATUS -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- App Title & Description -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Where Winds Meet Item Code Redeemer" 
                           FontSize="22" FontWeight="Bold" Foreground="#F8FAFC"/>
                <TextBlock Text="Discover active redemption codes and enter them automatically into your game window." 
                           FontSize="13" Foreground="#94A3B8" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- Game Window Detection Pill -->
            <Border Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="20" Padding="12,6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Status Dot -->
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#EF4444"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
                                        <Setter Property="Fill" Value="#10B981"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <!-- Status Text -->
                    <TextBlock Text="{Binding GameStatusText}" FontWeight="SemiBold" FontSize="12" Foreground="#F1F5F9" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <!-- Refresh Button -->
                    <Button Content="Refresh" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11"
                            Command="{Binding RefreshGameStatusCommand}" IsEnabled="{Binding CanOperate}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ACTION BAR & CONTROLS -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Fetch & Discover Codes -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Fetch Latest Codes" Style="{StaticResource RoundedButtonStyle}" Margin="0,0,10,0"
                            Command="{Binding FetchCodesCommand}" IsEnabled="{Binding CanOperate}"/>

                    <Button Content="Inspect Target Positions" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"
                            Command="{Binding InspectTargetsCommand}" IsEnabled="{Binding CanOperate}"
                            ToolTip="Moves cursor to configured buttons in the game without clicking so you can verify coordinates."/>

                    <Button Content="Calibrate Coordinates..." Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding OpenCalibrationCommand}" IsEnabled="{Binding CanOperate}"
                            ToolTip="Adjust where to click if game resolution or button positions change."/>
                </StackPanel>

                <!-- Center: Options checkboxes -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <CheckBox Content="Confirm each code" IsChecked="{Binding ConfirmEachCode}" Margin="0,0,14,0"
                              Foreground="#CBD5E1" VerticalAlignment="Center" Cursor="Hand"
                              ToolTip="Asks for your confirmation after each code before recording it as redeemed."/>

                    <CheckBox Content="Space-bar fallback" IsChecked="{Binding SpaceFallback}" Margin="0,0,14,0"
                              Foreground="#CBD5E1" VerticalAlignment="Center" Cursor="Hand"
                              ToolTip="Uses Space key to submit if Submit button is not calibrated."/>

                    <CheckBox Content="Stop after 1 code" IsChecked="{Binding StopAfterOne}"
                              Foreground="#CBD5E1" VerticalAlignment="Center" Cursor="Hand"
                              ToolTip="Stops after redeeming one code. Great for testing!"/>
                </StackPanel>

                <!-- Right: Big Action Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Start Redemption Button -->
                    <Button Content="Start Auto Redemption" Style="{StaticResource RedeemButtonStyle}"
                            Command="{Binding StartRedemptionCommand}"
                            Visibility="{Binding IsRedeeming, Converter={StaticResource InverseBooleanConverter}, ConverterParameter=vis}"/>

                    <!-- Stop Button -->
                    <Button Content="STOP Redemption" Style="{StaticResource StopButtonStyle}"
                            Command="{Binding StopRedemptionCommand}"
                            Visibility="{Binding IsRedeeming, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <!-- Codes List (70%) -->
                <ColumnDefinition Width="7*"/>
                <!-- Splitter -->
                <ColumnDefinition Width="10"/>
                <!-- Activity Log & Details (3*) -->
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: Codes Table -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Table Filter & Search Header -->
                        <RowDefinition Height="Auto"/>
                        <!-- Codes DataGrid -->
                        <RowDefinition Height="*"/>
                        <!-- Manual Code Add Footer -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Table Header Controls -->
                    <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="14,10" CornerRadius="8,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Filter Chips -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton Content="All Codes" Style="{StaticResource FilterRadioButtonStyle}"
                                             IsChecked="{Binding CurrentFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=All}">
                                    <RadioButton.ContentTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DataContext.TotalCodesCount, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='All ({0})'}"/>
                                        </DataTemplate>
                                    </RadioButton.ContentTemplate>
                                </RadioButton>

                                <RadioButton Content="Pending" Style="{StaticResource FilterRadioButtonStyle}"
                                             IsChecked="{Binding CurrentFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=PendingOnly}">
                                    <RadioButton.ContentTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DataContext.PendingCodesCount, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='Pending ({0})'}"/>
                                        </DataTemplate>
                                    </RadioButton.ContentTemplate>
                                </RadioButton>

                                <RadioButton Content="Redeemed" Style="{StaticResource FilterRadioButtonStyle}"
                                             IsChecked="{Binding CurrentFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=RedeemedOnly}">
                                    <RadioButton.ContentTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DataContext.RedeemedCodesCount, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='Redeemed ({0})'}"/>
                                        </DataTemplate>
                                    </RadioButton.ContentTemplate>
                                </RadioButton>
                            </StackPanel>

                            <!-- Search Input -->
                            <TextBox Grid.Column="1" Style="{StaticResource DarkTextBoxStyle}" Margin="10,0,10,0" Width="180" HorizontalAlignment="Right"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search code or source"/>

                            <!-- Quick Select Actions -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Select Pending" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Padding="8,4" FontSize="11"
                                        Command="{Binding SelectPendingOnlyCommand}" IsEnabled="{Binding CanOperate}"/>
                                <Button Content="Select All" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Padding="8,4" FontSize="11"
                                        Command="{Binding SelectAllCommand}" IsEnabled="{Binding CanOperate}"/>
                                <Button Content="Clear" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="11"
                                        Command="{Binding DeselectAllCommand}" IsEnabled="{Binding CanOperate}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Codes ListView / DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredCodes}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                              Background="#0F172A" RowBackground="#0F172A" AlternatingRowBackground="#151E32"
                              BorderThickness="0" GridLinesVisibility="None" HeadersVisibility="Column"
                              RowHeight="38" Foreground="#F8FAFC" FontSize="13">
                        <DataGrid.Resources>
                            <!-- Header Style -->
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#334155"/>
                            </Style>
                            <!-- Cell Style -->
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="8,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#1E3A8A"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.ContextMenu>
                            <ContextMenu Background="#1E293B" Foreground="#F8FAFC">
                                <MenuItem Header="Mark Selected as Redeemed" Command="{Binding MarkSelectedAsRedeemedCommand}"/>
                                <MenuItem Header="Mark Selected as Pending" Command="{Binding MarkSelectedAsPendingCommand}"/>
                                <Separator Background="#334155"/>
                                <MenuItem Header="Remove Selected from List" Command="{Binding RemoveSelectedCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <!-- Checkbox Select -->
                            <DataGridTemplateColumn Width="45">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Code Value -->
                            <DataGridTemplateColumn Header="Code" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Code}" FontFamily="Consolas, monospace" FontWeight="Bold" FontSize="14" Foreground="#38BDF8"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Source -->
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="160">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Status Badge -->
                            <DataGridTemplateColumn Header="Status" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Padding="8,3" HorizontalAlignment="Left"
                                                Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}">
                                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="11" Foreground="White"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Bottom Manual Code Add Row -->
                    <Border Grid.Row="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="14,10" CornerRadius="0,0,8,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,10,0"
                                     Text="{Binding ManualCodeInput, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Enter code manually (e.g. WWM2024)..."/>
                            <Button Grid.Column="1" Content="Add Code" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding AddManualCodeCommand}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="#1E293B" Cursor="SizeWE"/>

            <!-- RIGHT PANEL: Activity Log -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Activity Log" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Clear" Style="{StaticResource SecondaryButtonStyle}" Padding="6,2" FontSize="11"
                                Command="{Binding ClearLogCommand}"/>
                    </Grid>

                    <ListBox Grid.Row="1" ItemsSource="{Binding LogEntries}" x:Name="LogListBox"
                             Background="#0F172A" BorderBrush="#334155" BorderThickness="1"
                             Foreground="#CBD5E1" FontFamily="Consolas, monospace" FontSize="11"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM STATUS & PROGRESS BAR -->
        <Border Grid.Row="3" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Status or Redeeming Text -->
                <TextBlock Grid.Column="0" FontWeight="SemiBold" FontSize="13" Foreground="#38BDF8" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Ready"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Text" Value="{Binding BusyStatusText}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRedeeming}" Value="True">
                                    <Setter Property="Text" Value="{Binding ProgressText}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Center: Progress Bar (visible during redemption) -->
                <ProgressBar Grid.Column="1" Height="8" Margin="20,0" Minimum="0"
                             Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue}"
                             Foreground="#10B981" Background="#0F172A" BorderThickness="0"
                             Visibility="{Binding IsRedeeming, Converter={StaticResource BoolToVis}}"/>

                <!-- Right: Summary Counters -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedPendingCount, StringFormat='Selected: {0}'}" 
                               FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding PendingCodesCount, StringFormat='Pending: {0}'}" 
                               FontWeight="SemiBold" Foreground="#FBBF24" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding RedeemedCodesCount, StringFormat='Redeemed: {0}'}" 
                               FontWeight="SemiBold" Foreground="#10B981"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
