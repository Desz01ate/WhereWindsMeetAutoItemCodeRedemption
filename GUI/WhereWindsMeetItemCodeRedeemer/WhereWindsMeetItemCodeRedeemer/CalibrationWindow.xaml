<Window x:Class="WhereWindsMeetItemCodeRedeemer.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:WhereWindsMeetItemCodeRedeemer.Converters"
        mc:Ignorable="d"
        Title="Screen Calibration - Where Winds Meet Code Redeemer"
        Height="560" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI, Segoe UI Variable, sans-serif">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
        </Style>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#475569"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#475569"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#10B981"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Target Positions Calibration" Style="{StaticResource HeaderStyle}"/>
            <TextBlock Text="Calibrate click coordinates so the auto-redeemer knows where to click in Where Winds Meet."
                       Foreground="#94A3B8" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Instructions Banner -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14" Background="#1E293B">
            <StackPanel>
                <TextBlock Text="How it works:" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,4"/>
                <TextBlock Text="1. Click 'Capture' for a target below." Foreground="#CBD5E1"/>
                <TextBlock Text="2. You will have 3 seconds to switch to the game and hover your mouse directly over the button." Foreground="#CBD5E1"/>
                <TextBlock Text="3. A sound will play when captured! Use 'Test' to check if the mouse moves to the right spot." Foreground="#CBD5E1"/>
                <TextBlock Text="{Binding WindowResolutionText, StringFormat='Active Game Client Area: {0}'}" 
                           FontWeight="SemiBold" Foreground="#A7F3D0" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Targets Grid -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Exchange Button -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="1. Exchange Button" FontWeight="Bold" Foreground="#F8FAFC" FontSize="14"/>
                            <TextBlock Text="Button in game menu that opens the gift code exchange popup." Foreground="#94A3B8" Margin="0,2,0,4"/>
                            <TextBlock Text="{Binding ExchangeButton, StringFormat='Coordinates: {0}', FallbackValue='Not Calibrated'}"
                                       Foreground="#38BDF8" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Capture (3s)" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0"
                                    Command="{Binding CaptureTargetCommand}" CommandParameter="exchange"
                                    IsEnabled="{Binding CanOperate}"/>
                            <Button Content="Test" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding TestTargetCommand}" CommandParameter="exchange"
                                    IsEnabled="{Binding ExchangeButton, Converter={StaticResource NullToBoolConverter}}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Code Input Field -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="2. Code Input Field" FontWeight="Bold" Foreground="#F8FAFC" FontSize="14"/>
                            <TextBlock Text="Text box in the redemption dialog where the code is entered." Foreground="#94A3B8" Margin="0,2,0,4"/>
                            <TextBlock Text="{Binding CodeInput, StringFormat='Coordinates: {0}', FallbackValue='Not Calibrated'}"
                                       Foreground="#38BDF8" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Capture (3s)" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0"
                                    Command="{Binding CaptureTargetCommand}" CommandParameter="code_input"
                                    IsEnabled="{Binding CanOperate}"/>
                            <Button Content="Test" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding TestTargetCommand}" CommandParameter="code_input"
                                    IsEnabled="{Binding CodeInput, Converter={StaticResource NullToBoolConverter}}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Submit Button -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="3. Submit Button" FontWeight="Bold" Foreground="#F8FAFC" FontSize="14"/>
                            <TextBlock Text="The confirm/exchange button that redeems the code." Foreground="#94A3B8" Margin="0,2,0,4"/>
                            <TextBlock Text="{Binding SubmitButton, StringFormat='Coordinates: {0}', FallbackValue='Not Calibrated'}"
                                       Foreground="#38BDF8" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Capture (3s)" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0"
                                    Command="{Binding CaptureTargetCommand}" CommandParameter="submit"
                                    IsEnabled="{Binding CanOperate}"/>
                            <Button Content="Test" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding TestTargetCommand}" CommandParameter="submit"
                                    IsEnabled="{Binding SubmitButton, Converter={StaticResource NullToBoolConverter}}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Cancel Button -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="4. Cancel / Close Button" FontWeight="Bold" Foreground="#F8FAFC" FontSize="14"/>
                            <TextBlock Text="The close button (or X) to dismiss the dialog after redemption." Foreground="#94A3B8" Margin="0,2,0,4"/>
                            <TextBlock Text="{Binding CancelButton, StringFormat='Coordinates: {0}', FallbackValue='Not Calibrated'}"
                                       Foreground="#38BDF8" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Capture (3s)" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0"
                                    Command="{Binding CaptureTargetCommand}" CommandParameter="cancel"
                                    IsEnabled="{Binding CanOperate}"/>
                            <Button Content="Test" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding TestTargetCommand}" CommandParameter="cancel"
                                    IsEnabled="{Binding CancelButton, Converter={StaticResource NullToBoolConverter}}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Status / Countdown Message Banner -->
        <Border Grid.Row="3" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="#E2E8F0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Cancel Countdown" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CancelCaptureCommand}"
                        Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>

        <!-- Bottom Action Buttons -->
        <Grid Grid.Row="4" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Reset to Default Coordinates" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ResetToDefaultsCommand}" IsEnabled="{Binding CanOperate}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Save &amp; Apply" Style="{StaticResource SuccessButtonStyle}" Margin="0,0,8,0"
                        Command="{Binding SaveCalibrationCommand}" IsEnabled="{Binding CanOperate}" Padding="16,8"/>
                <Button Content="Close" Style="{StaticResource SecondaryButtonStyle}"
                        Click="OnCloseClick" Padding="16,8"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
